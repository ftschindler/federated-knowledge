#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""install-glue — make this machine fkb-ready.

Writes the two deterministic halves of a working setup, and hands off the one
non-deterministic half (the agent instructions) for the user or their agent to place.

It:
  1. creates the fkb config dir ($XDG_CONFIG_HOME/federated-knowledge or ~/.config/...),
  2. writes a starter workspace.okf.yaml there (with a proposed workspace_root) if absent,
  3. copies the fkb helper scripts (manifest.py + the bundle commands) into the config dir,
     so the skills and the user invoke one stable path regardless of where skills.sh installed,
  4. prints how to add the agent-instructions block (it never edits a file it does not own).

Usage:
  install-glue                       # set up with the default workspace_root
  install-glue --root ~/some/dir     # propose a different workspace_root
  install-glue --from <skill-dir>    # copy scripts from a repo checkout (dev loop), not the install
  install-glue --print-agents-block  # print ONLY the marker-wrapped block (for an agent to capture)
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

DEFAULT_WORKSPACE_ROOT = "~/.agents/knowledge"

# The helper scripts copied into the config dir. manifest.py is the core; the
# bundle commands sit beside it and import it.
HELPER_SCRIPTS = ["manifest.py", "install-glue", "clone-bundle", "add-bundle", "create-bundle"]

AGENTS_BLOCK = """\
<!-- BEGIN fkb (managed by federated-knowledge; edits between these markers are overwritten) -->
## Federated knowledge (fkb)

Durable knowledge lives in privacy-tiered OKF bundles, federated by a single manifest at
`~/.config/federated-knowledge/workspace.okf.yaml`. The `fkb-*` skills operate across all bundles;
each bundle is a standalone OKF repo.

**Query before you web-search.** `fkb-query "<question>"` fans across every bundle (reading is
unrestricted) and cites each hit bundle-qualified.

**Capture what's worth keeping** with `fkb-ingest` — it classifies the source to the right tier
(fail-closed to the most-private bundle), gates disclosure, and delegates the write to `kb-ingest`.

**The rules that keep tiers from leaking:**
- A concept in bundle A may reference bundle B only if A is in B's `referenceable_by`. Never
  hand-wire a cross-tier link that violates it.
- Never hand-edit bundle content — all writes go through the `kb-*` skills via `fkb-*`.
- Moving a concept to a more-open tier (`fkb-promote`) is irreversible disclosure — human-gated.

**Preflight:** the `fkb-*` skills delegate to the `kb-*` skills and need `uv`. If
`uv run ~/.config/federated-knowledge/manifest.py check-deps` fails, stop and install what it names.

If no manifest is configured at the path above, fkb is not set up on this machine — skip it and
proceed normally.
<!-- END fkb -->
"""


def config_dir() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "federated-knowledge"


def starter_manifest(workspace_root: str) -> str:
    return f"""\
# workspace.okf.yaml — the SOLE coupling point between your OKF bundles.
#
# This file was created by `install-glue`. It is the ONLY artifact that knows
# your bundles are related; each bundle stays an independent OKF repo.
#
# workspace_root: where tool-created bundles are checked out. A bundle with an
# absolute path ignores this and stays where it is. Delete this line if you only
# ever register bundles by absolute path.
workspace_root: {workspace_root}

# Add bundles with the helper commands, e.g.:
#   uv run ~/.config/federated-knowledge/clone-bundle <url> <name> [referenceable_by]
#   uv run ~/.config/federated-knowledge/add-bundle <name> <path>
#   uv run ~/.config/federated-knowledge/create-bundle <name>
bundles:
"""


def _script_source_dir(from_dir: str | None) -> Path:
    if from_dir:
        base = Path(from_dir).expanduser().resolve()
        # accept either the repo's skills/fkb/scripts or a dir that already holds the scripts
        candidate = base / "fkb" / "scripts"
        return candidate if candidate.is_dir() else base
    return Path(__file__).resolve().parent


def _copy_helpers(source: Path, dest: Path) -> list[str]:
    copied: list[str] = []
    for name in HELPER_SCRIPTS:
        src = source / name
        if src.is_file():
            shutil.copy2(src, dest / name)
            (dest / name).chmod(0o755)
            copied.append(name)
    return copied


def _parse_args(argv: list[str]) -> dict[str, object]:
    opts: dict[str, object] = {"root": DEFAULT_WORKSPACE_ROOT, "from": None, "print_block": False}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--root":
            i += 1
            opts["root"] = argv[i] if i < len(argv) else DEFAULT_WORKSPACE_ROOT
        elif arg == "--from":
            i += 1
            opts["from"] = argv[i] if i < len(argv) else None
        elif arg == "--print-agents-block":
            opts["print_block"] = True
        else:
            sys.stderr.write(f"install-glue: unknown argument {arg!r}\n")
            sys.exit(64)
        i += 1
    return opts


def main(argv: list[str]) -> None:
    opts = _parse_args(argv)

    if opts["print_block"]:
        sys.stdout.write(AGENTS_BLOCK)
        return

    cfg = config_dir()
    cfg.mkdir(parents=True, exist_ok=True)

    manifest = cfg / "workspace.okf.yaml"
    created_manifest = not manifest.exists()
    if created_manifest:
        manifest.write_text(starter_manifest(str(opts["root"])), encoding="utf-8")

    source = _script_source_dir(opts["from"])  # type: ignore[arg-type]
    copied = _copy_helpers(source, cfg)

    sys.stdout.write(f"fkb config dir: {cfg}\n")
    sys.stdout.write(
        f"  workspace.okf.yaml: {'created' if created_manifest else 'kept (already existed)'}\n"
    )
    sys.stdout.write(f"  helper scripts copied: {', '.join(copied) if copied else 'none found'}\n")
    sys.stdout.write("\nNext: make your agent aware of fkb. Either paste the block from\n")
    sys.stdout.write(f"  uv run {cfg / 'install-glue'} --print-agents-block\n")
    sys.stdout.write(
        "into your agent's instruction file (AGENTS.md / CLAUDE.md), or ask your agent to do it.\n"
    )


if __name__ == "__main__":
    main(sys.argv[1:])
