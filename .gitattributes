# Normalise all text to LF on commit, independent of contributor OS.
# Pairs with .editorconfig and the mixed-line-ending pre-commit hook
# (belt-and-braces LF enforcement).
* text=auto eol=lf

# Explicit text types (documentation + tooling)
*.md        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.example   text eol=lf
*.sh        text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf

# Binary assets: store in Git LFS (keeps history lean), and `-text` exempts them
# from the `* text eol=lf` normalisation above so LFS and line-ending rules don't
# collide. Run `git lfs track` / `git lfs install` before committing such files.
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text
*.webp      filter=lfs diff=lfs merge=lfs -text
*.svg       filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text
